# --- Core app (all required to run) ---

# Postgres connection string, e.g. postgres://user:password@host:5432/lensflow
DATABASE_URL=

# Long random string used to sign session cookies (server/auth.ts). Generate
# one with: openssl rand -hex 32 — then never change it without expecting
# everyone to be logged out.
JWT_SECRET=

# Email (case-insensitive) that automatically gets the "admin" role on
# signup — set this to your own account's email before you register.
OWNER_EMAIL=

# Stripe secret key for checkout + webhooks (dashboard: Developers -> API keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Live broadcasting ---

# LiveKit — REQUIRED for real "Go Live" broadcasting (/studio) and the fan
# viewer (/live). This is the actual WebRTC backend: browser publishes
# directly to a LiveKit room, no relay server, and viewer tokens are issued
# with canPublish: false — enforced server-side by LiveKit, not just app
# convention. Server-side only, NEVER prefix with VITE_ or expose to the
# client. Dashboard: cloud.livekit.io -> your project -> Settings -> API keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Mux Data — client-side-safe environment key for video-quality analytics on
# the /watch page's player. Not used for live broadcasting (see server/mux.ts
# for why: Mux Video only accepts RTMP/SRT ingest, not WebRTC, so it isn't
# the live path here — LiveKit is). Dashboard: Settings -> Environments.
# Safe to expose in browser code.
VITE_MUX_DATA_ENV_KEY=

# Mux Video — optional. Only needed if you want to create Mux live streams
# for OBS/RTMP-based broadcasting as an alternative to the browser-based
# LiveKit path (e.g. a creator who prefers streaming from OBS). Server-side
# only, NEVER prefix with VITE_ or expose to the client. Dashboard:
# Settings -> Access Tokens -> generate a token with "Mux Video" permission.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
